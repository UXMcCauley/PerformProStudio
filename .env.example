# =============================================================================
# IntelliPrompter Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# MongoDB (Required)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB=intelliprompter

# -----------------------------------------------------------------------------
# NextAuth (Required)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Anthropic AI (Required for lyrics processing)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# -----------------------------------------------------------------------------
# Spotify API (Optional - enables richer search with audio features)
# Get credentials at: https://developer.spotify.com/dashboard
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# -----------------------------------------------------------------------------
# Genius API (Optional - enables lyrics lookup and songwriter info)
# Get token at: https://genius.com/api-clients
# -----------------------------------------------------------------------------
GENIUS_ACCESS_TOKEN=your-genius-access-token

# -----------------------------------------------------------------------------
# Apple Music (Optional - requires Apple Developer Program $99/year)
# More info: https://developer.apple.com/musickit/
# -----------------------------------------------------------------------------
# APPLE_MUSIC_KEY_ID=your-key-id
# APPLE_MUSIC_TEAM_ID=your-team-id
# APPLE_MUSIC_PRIVATE_KEY=your-private-key

# -----------------------------------------------------------------------------
# TIDAL (Optional - enables TIDAL integration)
# Get credentials at: https://developer.tidal.com
# -----------------------------------------------------------------------------
# TIDAL_CLIENT_ID=your-tidal-client-id
# TIDAL_CLIENT_SECRET=your-tidal-client-secret

# -----------------------------------------------------------------------------
# Free APIs (No configuration needed)
# -----------------------------------------------------------------------------
# Deezer API - Works without authentication
# MusicBrainz API - Works without authentication (rate limited to 1 req/sec)

# -----------------------------------------------------------------------------
# Legacy Supabase (Deprecated - migrated to MongoDB)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
